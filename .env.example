# Sao chep thanh .env roi dien. File .env da nam trong .gitignore.
GCP_PROJECT_ID=dataops-poc-2026
GCP_REGION=asia-southeast1

# Local: Postgres trong docker-compose
DATABASE_URL=postgresql://dataops:dataops@localhost:5432/dataops

# Dataset nguon tren BigQuery (P2 moi dung toi)
BIGQUERY_DATASET=

# Tren Cloud Run dat = true de bat buoc verify IAP JWT
REQUIRE_IAP=false
